NODE_ENV=development
PORT=5000

# Hostinger / cPanel MySQL Configuration
DB_HOST=localhost
DB_USER=u123456789_orbit_user
DB_PASSWORD=YourHostingerStrongDbPassword2026
DB_NAME=u123456789_orbit_db
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# Optional MongoDB connection string (if using Mongo)
MONGODB_URI=mongodb://127.0.0.1:27017/orbit-i

# JWT secrets — generate strong random values for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend origin allowed by CORS + used for cookie settings
CLIENT_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Cloudinary — image storage
# Sign up for free tier at https://cloudinary.com/
# Get these values from your Cloudinary dashboard (Settings > API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
